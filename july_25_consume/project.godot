; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fictional_Options_Manager]

General/option_sections=[&"AudioOptions"]

[application]

config/name="Untitled Goat Game"
run/main_scene="uid://barkea7j1yfm6"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/image="uid://bjkbgaqswjxae"
config/icon="res://icon.svg"

[autoload]

FictionalOptionsManager="*res://addons/fictional_options_manager/options_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/size/borderless=true
window/energy_saving/keep_screen_on=false
window/stretch/mode="viewport"
window/stretch/aspect="keep_width"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/auto_class_name/plugin.cfg", "res://addons/fictional_options_manager/plugin.cfg")

